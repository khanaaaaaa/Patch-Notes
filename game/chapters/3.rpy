label version_03:

    narrator "[ VERSION 0.3 - Rewrites ]"
    narrator "The developer begins rewriting dialogue."
    narrator "Characters slowly lose memories."

    eli "Mina, how's the painting going?"
    mina "Painting? I've always hated art."
    eli "...You showed me a canvas last week."
    mina "I don't know what you mean."

    narrator "The mayor's wedding photo changes while Eli watches."
    narrator "Books rewrite themselves mid-sentence."
    narrator "Signs change whileyou're reading them."
    narrator "Only Eli remembers."

    eli "I need to write this down."
    narrator "He starts a notebook."
    narrator "Every morning, half the notes have vanished."

    $ notebook_entries.append("Mina used to love painting.")
    $ notebook_entries.append("The mayor had a wife, her name was Clara.")

    jump version_035

label version_035:

    narrator "[ VERSION 0.35 - Broken Build ]"
    narrator "The developer accidentaly uploads an unstable version."

    narrator "Rain falls indoors."
    narrator "Trees float."
    narrator "NPCs walk through walls."
    narrator "Time skips randomly."
    narrator "One day... the sun never rises."
    narrator "No one comments."

    eli "Is anyone seeing this?"
    mina "Seeing what?"

    jump version_04